{
  "extends": "@beatzball/caribou-tsconfig/app.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": ["./*"]
    },
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": ["pages", "components", "server", "tests", "types", "*.ts", "*.config.ts"],
  "exclude": ["node_modules", ".output", ".nitro"]
}
